<Window x:Class="SistemaRupireV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaRupireV2"
        mc:Ignorable="d"
        Title="Sistema Bodega Rupire" Height="600" Width="1126" WindowStartupLocation="CenterScreen" Background="#FFFDFBF7">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="34*"/>
            <RowDefinition Height="34*"/>
            <RowDefinition Height="34*"/>
            <RowDefinition Height="34*"/>
            <RowDefinition Height="146*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="287*"/>
            <ColumnDefinition Width="839*"/>
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="spFondo2" Grid.ColumnSpan="2" Background="#FF233133"/>
        <StackPanel x:Name="spFondo" Margin="0,114,0,0" Grid.RowSpan="7" Background="#FF233133"/>
        <Image Grid.Column="0" 
           Source="pack://application:,,,/Recursos/Logo_Bodega.png" 
           Width="192" Height="103" 
           HorizontalAlignment="Left" VerticalAlignment="Top" 
           Margin="26,0,0,0" 
           Stretch="UniformToFill" RenderTransformOrigin="0.472,0.605"/>

        <TextBlock HorizontalAlignment="Left" Margin="228,19,0,0" TextWrapping="Wrap" Text="SISTEMA BODEGA RUPIRE" VerticalAlignment="Top" Height="65" Width="670" TextAlignment="Center" FontSize="48" FontWeight="Bold" Grid.ColumnSpan="2" Foreground="#FFFDFBF7"/>

        <TextBlock x:Name="txtbMenu" TextWrapping="Wrap" Text="MENÚ" Margin="21,7,184,7" FontWeight="Bold" FontSize="22" Grid.Row="1" Foreground="#FFD6B588" TextAlignment="Center" RenderTransformOrigin="0.76,0.523" Cursor="Hand"/>

        <Button x:Name="btnInicio" Content="  🏠  INICIO" HorizontalAlignment="Left" Margin="28,0,0,0" VerticalAlignment="Center" Grid.Row="2" Height="31" Width="130" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="#FFFDFBF7" FontWeight="Bold" FontSize="20" Click="btnInicio_Click" Cursor="Hand"/>
        <Button x:Name="btnCliente" Content="  👥  CLIENTES" HorizontalAlignment="Left" Grid.Row="3" VerticalAlignment="Center" Width="150" Height="29" FontWeight="Bold" FontSize="20" BorderBrush="{x:Null}" Foreground="#FFFDFBF7" Background="{x:Null}" Click="BtnCliente_Click" Margin="28,0,0,0" Cursor="Hand"/>
        <Button x:Name="btnProveedores" Content="  📦  PROVEEDORES" HorizontalAlignment="Left" Grid.Row="4" VerticalAlignment="Top" Width="194" Height="29" FontWeight="Bold" FontSize="20" BorderBrush="{x:Null}" Foreground="#FFFDFBF7" Background="{x:Null}" Margin="28,8,0,0" Cursor="Hand"/>
        <Button x:Name="btnCaja" Content="  💰  CAJA" HorizontalAlignment="Left" Grid.Row="5" VerticalAlignment="Center" Width="110" Height="29" FontWeight="Bold" FontSize="20" BorderBrush="{x:Null}" Foreground="#FFFDFBF7" Background="{x:Null}" Margin="28,0,0,0" Cursor="Hand"/>

        <ContentControl x:Name="MainContentControl" Grid.Column="1" Grid.Row="1" Grid.RowSpan="6" Margin="10">
            <TextBox x:Name="txtSistema" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="583" Height="38" Background="#FFF8EEEE" TextAlignment="Center" FontSize="14" Margin="0,402,0,0"/>
        </ContentControl>

    </Grid>
</Window>