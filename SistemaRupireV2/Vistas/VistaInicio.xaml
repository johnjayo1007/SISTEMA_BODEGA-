<UserControl x:Class="SistemaRupireV2.Vistas.VistaInicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             Height="450" Width="780" Background="#FF1A1A1A">

    <Grid>
        <Image Source="pack://application:,,,/Recursos/Bodega_rupire1.jpg" 
       Stretch="UniformToFill" 
       Opacity="0.35" 
       HorizontalAlignment="Center"
       VerticalAlignment="Center"/>

        <StackPanel VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Margin="20">

            <TextBlock Text="¡Bienvenido al Sistema!" 
                       FontSize="34" 
                       FontWeight="Bold" 
                       Foreground="#FFFFFFFF" 
                       TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.8" ShadowDepth="2"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="Panel de gestión y control para Bodega Rupire" 
                       FontSize="16" 
                       Foreground="#FFE6E6E6" 
                       TextAlignment="Center" 
                       Margin="0,10,0,25">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="6" Color="Black" Opacity="0.6" ShadowDepth="1"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="Seleccione una opción del menú lateral para comenzar a operar." 
                       FontSize="13" 
                       Foreground="#FFD9D9D9" 
                       HorizontalAlignment="Center" 
                       FontStyle="Italic">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="4" Color="Black" Opacity="0.5" ShadowDepth="1"/>
                </TextBlock.Effect>
            </TextBlock>

        </StackPanel>
    </Grid>
</UserControl>